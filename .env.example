# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key, used server-side only (src/lib/ai, src/app/api).
ANTHROPIC_API_KEY=

# Claude model id used for receipt extraction/estimation. Defaults to
# claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Prisma connection string. SQLite file for local dev; swap to a Postgres
# URL (e.g. Neon/Supabase) in production without any code changes.
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5). Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth 2.0 credentials from Google Cloud Console (see README for
# step-by-step setup). Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed in production, where Auth.js can't infer the deployed URL from
# the request (e.g. behind certain proxies/CDNs). Leave unset for local dev.
# AUTH_URL="https://your-production-domain.com"
